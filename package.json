{
  "name": "dsh-system-net",
  "version": "0.2.0",
  "description": "Make DeepSeek Harness follow your system network settings — route traffic through the operating system's proxy AND trust its certificate store, so TLS-intercepting accelerators and corporate proxies work without environment variables or a restart. 让 DeepSeek Harness 跟随系统网络设置：既走系统代理，也信任系统证书库，无需环境变量、无需重启。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chickmat/dsh-system-net.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "proxy",
    "system-proxy",
    "certificate",
    "system-ca",
    "tls",
    "ssl",
    "self-signed",
    "watt-toolkit",
    "steampp",
    "china-network"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.5.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/pure.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-http-proxy": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-http-proxy": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
